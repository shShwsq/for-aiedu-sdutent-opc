# GitHub OAuth Client ID(前端拼接授权链接用,不含 secret)
VITE_GITHUB_OAUTH_CLIENT_ID=

# GitHub OAuth 回调地址(需与后端 GITHUB_OAUTH_REDIRECT_URI 一致)
VITE_GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# Gitee OAuth Client ID(前端拼接授权链接用,不含 secret)
# 在 https://gitee.com/oauth/applications 创建第三方应用获取
VITE_GITEE_OAUTH_CLIENT_ID=

# Gitee OAuth 回调地址(需与后端 GITEE_OAUTH_REDIRECT_URI 一致)
VITE_GITEE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/gitee/callback
