# AgentPair 前端镜像:node 构建静态产物 → nginx 托管
# 构建:docker build -f deploy/Dockerfile.frontend -t agentpair-frontend .
FROM node:22-alpine AS build
WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .

# VITE_* 变量是构建期嵌入的,由 docker compose build --build-arg / env 注入
ARG VITE_GITHUB_OAUTH_CLIENT_ID=""
ARG VITE_GITHUB_OAUTH_REDIRECT_URI=""
ARG VITE_GITEE_OAUTH_CLIENT_ID=""
ARG VITE_GITEE_OAUTH_REDIRECT_URI=""
ENV VITE_GITHUB_OAUTH_CLIENT_ID="${VITE_GITHUB_OAUTH_CLIENT_ID}" \
    VITE_GITHUB_OAUTH_REDIRECT_URI="${VITE_GITHUB_OAUTH_REDIRECT_URI}" \
    VITE_GITEE_OAUTH_CLIENT_ID="${VITE_GITEE_OAUTH_CLIENT_ID}" \
    VITE_GITEE_OAUTH_REDIRECT_URI="${VITE_GITEE_OAUTH_REDIRECT_URI}"

RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
